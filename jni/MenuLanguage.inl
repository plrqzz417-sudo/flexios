static const char* tr(const char* text) {
    if(language<=0||language>2)return text;
    int first=0,last=int(sizeof(menu_strings)/sizeof(*menu_strings));
    while(first<last){
        const int middle=first+(last-first)/2;
        const int order=std::strcmp(menu_strings[middle][0],text);
        if(order==0)return menu_strings[middle][language];
        if(order<0)first=middle+1;else last=middle;
    }
    return text;
}
static void language_picker() {
    const char* choices[]={"Português","English","Русский"};
    const bool cyrillic=ImGui::GetFont()->FindGlyphNoFallback(0x0420)!=nullptr;
    if(!cyrillic&&language==2)language=0;
    ImGui::TextUnformatted(tr("Idioma"));
    ImGui::SetNextItemWidth(-1);
    ImGui::Combo("##language",&language,choices,cyrillic?3:2);
}
